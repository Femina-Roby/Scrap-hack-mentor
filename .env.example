# Settings for running against a real Postgres. Without DATABASE_URL, an embedded PGlite is used.
# Use with: node --env-file=.env dev.mjs   (Node 20.6+), or set them in your host's dashboard.
ADMIN_PASSWORD=change-me
DATABASE_URL=postgres://user:password@host:5432/dbname
# Optional: event code mentors type when they join
MENTOR_CODE=
